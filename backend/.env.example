# ============================================================
#  MetricasCalidad — Backend Variables de Entorno
#  Copia este archivo a ".env" y rellena con tus valores reales.
#  El archivo ".env" NUNCA debe subirse a Git.
# ============================================================

# Puerto del servidor Express (desarrollo local)
PORT=3001

# ── SQL Server ──────────────────────────────────────────────
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MetricasCalidad
DB_USER=sa
DB_PASSWORD=tu_password_aqui

# false  → desarrollo local (sin TLS)
# true   → producción / Azure SQL (con TLS)
DB_ENCRYPT=false

# true   → acepta certificados auto-firmados (desarrollo)
# false  → producción con certificado válido
DB_TRUST_CERT=true

# ── CORS ────────────────────────────────────────────────────
# Origen(es) del frontend permitidos.
# Para múltiples: http://localhost:5173,http://192.168.1.50:5173
CORS_ORIGIN=http://localhost:5173
