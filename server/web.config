<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Le indica a IIS que maneje las peticiones con iisnode -->
    <handlers>
      <add name="iisnode" path="dist/index.js" verb="*" modules="iisnode" />
    </handlers>
    
    <!-- Redirige todas las URLs hacia Express (dist/index.js) -->
    <rewrite>
      <rules>
        <rule name="NodeExpress">
          <match url="/*" />
          <action type="Rewrite" url="dist/index.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>